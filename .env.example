# ===========================================
# SouNativo — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha
# ===========================================

# Firebase Web App Config (Firebase Console -> Configurações do Projeto)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Opcional: Banco Firestore nomeado (padrão: "(default)")
# VITE_FIREBASE_DATABASE_ID=

# Opcional: Emuladores locais (true / false)
VITE_USE_FIREBASE_EMULATORS=false

# Opcional: Email do administrador master
VITE_MASTER_ADMIN_EMAIL=admin@sounativo.com

# Opcional: Google Maps API Key (para mapas avançados no futuro)
VITE_GOOGLE_MAPS_API_KEY=
