# ============================================================================
# SouNativo — Template de Variáveis de Ambiente (.env.example)
# ============================================================================
# INSTRUÇÕES DE SEGURANÇA (DevSecOps):
# 1. Copie este arquivo para `.env.local` em desenvolvimento local (`cp .env.example .env.local`).
# 2. NUNCA comite `.env.local` ou chaves privadas no Git (já bloqueado no .gitignore).
# 3. Qualquer variável iniciada com `VITE_` é exposta no bundle público do navegador.
#    JAMAIS insira chaves de serviço (Service Account JSON, Admin SDK ou segredos de API privada)
#    com prefixo `VITE_`. A segurança dos dados reside nas `firestore.rules` e Firebase Auth.
# ============================================================================

# --- Firebase Web SDK (Público / Protegido por Authorized Domains & Firestore Rules) ---
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# --- Opcional: Banco Firestore nomeado (deixe vazio para "(default)") ---
# VITE_FIREBASE_DATABASE_ID=

# --- Governança & LGPD / Consentimento de Analytics ---
# Só inicializa coleta caso o titular aprove a categoria "Analytics" no CookieBanner
VITE_GA_MEASUREMENT_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Administração Master (Validada no backend via Custom Claims / email_verified) ---
VITE_MASTER_ADMIN_EMAIL=admin@seudominio.com

# --- Desenvolvimento Local (Firebase Emulator Suite) ---
VITE_USE_FIREBASE_EMULATORS=false

# --- Integrações Opcionais de Interface ---
VITE_GOOGLE_MAPS_API_KEY=

# --- Serverless / Vercel Functions (NUNCA usar prefixo VITE_ para chaves abaixo) ---
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=SouNativo <notificacoes@sounativo.com>
ADMIN_ALERT_EMAIL=
NOTIFY_WEBHOOK_URL=
